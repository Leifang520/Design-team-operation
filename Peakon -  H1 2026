<script>
  // Simple left-anchored bar chart. Map eNPS (−100..+100) to visual width %.
  // bar width = (score + 100) / 200 * 100   →  −100 = 0%, 0 = 50%, +100 = 100%
  const drivers = [
    // ── Above DH benchmark ──
    ["Freedom of Opinion",        62,  55, "green"],
    ["Autonomy — Flexibility",    38,  36, "green"],
    ["Reward",                     8,   2, "green"],
    // ── Watch ──
    ["Engagement",                23,  34, "amber"],
    ["Strategy",                 -17,  23, "amber"],
    ["Meaningful Work",          -23,  19, "amber"],
    // ── Focus areas ──
    ["Recognition",                8,  27, "red"],
    ["Environment — Equipment",    8,  43, "red"],
    ["Goal Setting",              -8,  44, "red"],
    ["Growth — Learning",        -15,  36, "red"],
  ];

  const chart = document.getElementById("driverChart");

  drivers.forEach(([name, score, dh, color]) => {
    const barW = ((score + 100) / 200 * 100).toFixed(1);
    const gap  = score - dh;
    const gapSign = gap >= 0 ? "+" : "";
    const gapCls  = gap >= 0 ? "pos" : "neg";
    const scoreSign = score > 0 ? "+" : "";

    const row = document.createElement("div");
    row.className = "driver-row";
    row.innerHTML = `
      <div class="driver-name">${name}</div>
      <div class="bar-track">
        <div class="bar-fill ${color}" style="width:${barW}%"></div>
      </div>
      <div class="score-meta">
        <span class="score-main">${scoreSign}${score}</span>
        <span class="score-dh">DH: ${dh > 0 ? "+" : ""}${dh}</span>
        <span class="score-gap ${gapCls}">${gapSign}${gap} vs DH</span>
      </div>
    `;
    chart.appendChild(row);
  });
</script>

